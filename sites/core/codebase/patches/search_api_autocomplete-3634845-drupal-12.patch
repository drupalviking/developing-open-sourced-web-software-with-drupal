--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -55,27 +55,56 @@ variables:
   OPT_IN_TEST_PREVIOUS_MAJOR: 1
   OPT_IN_TEST_PREVIOUS_MINOR: 1
   OPT_IN_TEST_NEXT_MINOR: 1
-  OPT_IN_TEST_NEXT_MAJOR: 0
+  OPT_IN_TEST_NEXT_MAJOR: 1
   OPT_IN_TEST_DRUPAL_CMS: 1
   OPT_IN_TEST_MAX_PHP: 1
   # Uncomment to automatically run various optional tests:
 #  _AUTORUN_PREVIOUS_MINOR: all
 #  _AUTORUN_NEXT_MINOR: all
 #  _AUTORUN_PREVIOUS_MAJOR: all
-#  _AUTORUN_NEXT_MAJOR: all
+  _AUTORUN_CURRENT: none
+  _AUTORUN_NEXT_MAJOR: all
 #  _AUTORUN_DRUPAL_CMS: all
 #  _AUTORUN_MAX_PHP: all
 
+phpstan:
+  rules:
+    - when: never
+
 # Use the latest version of Search API for testing.
-composer:
+.composer-base:
   after_script:
     - composer require drupal/search_api:1.x-dev
 
-# Enable deprecation warnings during tests.
-phpunit:
+# Temporary fix for Drupal 12 tests: Declare Drupal 12 compatibility for the
+# search_api_page module.
+# @todo Remove once search_api_page is available for Drupal 12.
+composer (next major):
+  variables:
+    _LENIENT_ALLOW_LIST: 'search_api_page'
+
+.phpunit-base:
+  before_script:
+    # Merge Core's deprecation ignore file into the module's own file.
+    # Make sure the Core file exists (for older Drupal versions)
+    - |
+      CORE_FILE="$CI_PROJECT_DIR/$_WEB_ROOT/core/.deprecation-ignore.txt"
+      touch "$CORE_FILE"
+      cat "$CORE_FILE" >> "$DRUPAL_PROJECT_FOLDER/.ignored-deprecations.txt"
+      echo "Added `wc -l $CORE_FILE` lines to $DRUPAL_PROJECT_FOLDER/.ignored-deprecations.txt."
+  # Enable deprecation warnings during tests.
   variables:
+    # For Drupal 11.5+.
+    DRUPAL_DEPRECATION_FILTER_CONFIG: '{"projectIgnoreFile":"$CI_PROJECT_DIR/.ignored-deprecations.txt"}'
+    # For older Drupal versions.
+    # @todo Remove once we depend on Drupal 11.5+.
     SYMFONY_DEPRECATIONS_HELPER: "ignoreFile=$CI_PROJECT_DIR/.ignored-deprecations.txt"
 
+# Do not run PHPStan for previous Drupal versions.
+phpstan (previous major):
+  rules:
+    - when: never
+
 # Override the default pipeline to start chromedriver slightly differently.
 default:
   services:
